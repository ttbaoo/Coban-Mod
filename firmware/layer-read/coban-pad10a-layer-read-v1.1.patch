diff --git a/keyboards/coban/pad10a/hid/layer_read.c b/keyboards/coban/pad10a/hid/layer_read.c
new file mode 100644
index 0000000..0a831dc
--- /dev/null
+++ b/keyboards/coban/pad10a/hid/layer_read.c
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "layer_read.h"
+#include <string.h>
+
+static void write_be32(uint8_t *out, uint32_t value) {
+    out[0] = (uint8_t)(value >> 24);
+    out[1] = (uint8_t)(value >> 16);
+    out[2] = (uint8_t)(value >> 8);
+    out[3] = (uint8_t)value;
+}
+
+bool coban_layer_read_reply(uint8_t *payload, uint8_t length, uint32_t layers, uint32_t defaults, uint8_t count, uint32_t uptime) {
+    if (payload == NULL || length != COBAN_LAYER_READ_PAYLOAD_SIZE) {
+        return false;
+    }
+    memset(payload, 0, COBAN_LAYER_READ_PAYLOAD_SIZE);
+    memcpy(payload, "CBLR", 4);
+    payload[4] = 1; // Wire version, independent of VIA/firmware version.
+    payload[5] = 3; // Bit 0: live masks; bit 1: single-decoder GIF reload fix.
+    uint32_t effective = layers | defaults;
+    uint8_t highest = 0; // QMK resolves an empty mask to layer 0.
+    for (uint8_t bit = 0; bit < 32; ++bit) {
+        if (effective & (UINT32_C(1) << bit)) {
+            highest = bit;
+        }
+    }
+    if (count == 0 || count > 32 || highest >= count) {
+        payload[5] |= 0x80; // Invalid runtime state, host must not select an image.
+        highest = 0xff;
+    }
+    payload[6] = highest;
+    payload[7] = count;
+    write_be32(payload + 8, layers);
+    write_be32(payload + 12, defaults);
+    write_be32(payload + 16, uptime);
+    // Bytes 20..28 reserved, zero. No change counter is advertised in v1.
+    return true;
+}
diff --git a/keyboards/coban/pad10a/hid/layer_read.h b/keyboards/coban/pad10a/hid/layer_read.h
new file mode 100644
index 0000000..abf32ab
--- /dev/null
+++ b/keyboards/coban/pad10a/hid/layer_read.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define COBAN_LAYER_READ_VALUE_ID 0x65
+#define COBAN_LAYER_READ_PAYLOAD_SIZE 29
+
+// Stateless encoder: only writes the supplied USB response, never device state.
+bool coban_layer_read_reply(uint8_t *payload, uint8_t length, uint32_t layers, uint32_t defaults, uint8_t count, uint32_t uptime);
diff --git a/keyboards/coban/pad10a/keymaps/coban_mod/config.h b/keyboards/coban/pad10a/keymaps/coban_mod/config.h
new file mode 100644
index 0000000..f41c0e5
--- /dev/null
+++ b/keyboards/coban/pad10a/keymaps/coban_mod/config.h
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+// The pinned upstream reserves only 4 KiB after the GIF, but its RP2040
+// EEPROM backing store occupies the final 8 KiB. Keep EEPROM where it is,
+// and move only the 100 KiB GIF region down by one 4 KiB erase sector.
+#define WEAR_LEVELING_BACKING_SIZE 8192
+#undef EEROM_CB_GIF_ADDR
+#define EEROM_CB_GIF_ADDR (PICO_FLASH_SIZE_BYTES - EEPROM_MAX_GIF_SIZE - WEAR_LEVELING_BACKING_SIZE)
