+    [3] = LAYOUT(KC_MPLY, TO(0), QK_KB_0, QK_BACKLIGHT_DOWN, QK_BACKLIGHT_UP, QK_BOOTLOADER, QK_KB_1, QK_KB_7, QK_KB_5, QK_KB_6),
